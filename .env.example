# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Used to build email confirmation links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: lets onboarding suggest rituals from three questions.
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: defaults to gpt-6-luna
OPENAI_MODEL=

# Optional: lets users connect Todoist. Register an app at
# https://app.todoist.com/app/settings/integrations/app-management and set its
# OAuth redirect URL to <site>/api/integrations/todoist/callback
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=
# Encrypts integration tokens at rest. Generate with: openssl rand -base64 32
INTEGRATIONS_ENCRYPTION_KEY=
